map $uri $cache_policy {
    default "no-cache";
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/api/ "no-store";
    "/api-wake-config.json" "no-store";
}
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https https;
    http http;
}
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 256k;
    add_header Cache-Control $cache_policy always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ${CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    location = /healthz { access_log off; return 200 'ok'; default_type text/plain; }
    location = /api-wake-config.json {
        access_log off;
        default_type application/json;
        return 200 '{"wake_url":"${API_WAKE_URL}"}';
    }
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_hide_header Cache-Control;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_set_header Rndr-Id "";
        proxy_set_header Render-Proxy-Ttl "";
        proxy_set_header Cdn-Loop "";
        proxy_set_header Cf-Ray "";
        proxy_set_header Cf-Connecting-Ip "";
        proxy_set_header Cf-Ipcountry "";
        proxy_set_header Cf-Visitor "";
        proxy_set_header True-Client-Ip "";
        proxy_set_header X-Request-Start "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
